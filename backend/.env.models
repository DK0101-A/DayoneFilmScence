# Day One Film AI - 模型配置策略
# 影视场景搜索工具模型集合配置

# ============================================
# 模型分层配置
# ============================================

# 第一层：场景搜索（B模块）
SCENE_SEARCH_MODEL=gemini-2.0-flash
SCENE_SEARCH_FALLBACK=gemini-1.5-pro

# 第二层：剧本拆解（A模块）
SCRIPT_PARSE_MODEL=claude-3-5-sonnet
SCENE_EXTRACTION_MODEL=gemini-1.5-pro
SHOT_GENERATION_MODEL=gemini-2.0-flash

# 第三层：高级功能（C/D/E模块）
STYLE_ANALYSIS_MODEL=gemini-1.5-pro-vision
PROMPT_GENERATION_MODEL=claude-3-5-sonnet

# ============================================
# 成本阈值控制（自动降级）
# ============================================

# 当成本超过阈值时，自动切换到 cheaper 模型
COST_THRESHOLD_DAILY=50  # ¥50/天
COST_THRESHOLD_MONTHLY=1000  # ¥1000/月

# 自动降级策略
AUTO_DOWNGRADE=true
DOWNGRADE_TO=gemini-2.0-flash

# ============================================
# API易配置（国内方案）
# ============================================

APIYI_BASE_URL=https://api.apiyi.com/v1
APIYI_API_KEY=your_apiyi_key

# API易模型映射
APIYI_SCENE_MODEL=gemini-2.0-flash
APIYI_SCRIPT_MODEL=gemini-1.5-pro
APIYI_VISION_MODEL=gemini-1.5-pro-vision

# ============================================
# 官方Google配置（海外方案）
# ============================================

GEMINI_API_KEY=your_gemini_key
GEMINI_SCENE_MODEL=gemini-2.0-flash
GEMINI_SCRIPT_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-pro-vision

# ============================================
# 模型选择策略
# ============================================

# 根据任务复杂度自动选择
MODEL_SELECTION_STRATEGY=auto

# 简单任务（<100 tokens）
SIMPLE_TASK_MODEL=gemini-2.0-flash

# 中等任务（100-1000 tokens）
MEDIUM_TASK_MODEL=gemini-1.5-pro

# 复杂任务（>1000 tokens）
COMPLEX_TASK_MODEL=claude-3-5-sonnet

# ============================================
# 备用方案（主模型失败时）
# ============================================

# 第一层备用
FALLBACK_L1=gemini-2.0-flash

# 第二层备用
FALLBACK_L2=gemini-1.5-pro

# 第三层备用
FALLBACK_L3=claude-3-5-sonnet

# ============================================
# 性能优化
# ============================================

# 缓存配置
ENABLE_CACHE=true
CACHE_TTL=3600  # 1小时

# 批量处理
BATCH_SIZE=10
MAX_CONCURRENT=5

# 超时设置
TIMEOUT_SIMPLE=5  # 秒
TIMEOUT_COMPLEX=30  # 秒
