# Day One Film AI - Environment Configuration
# 复制为 .env 并填写真实值

# ============================================
# AI模型配置
# ============================================

# AI Studio / Gemini (开发期快速验证)
GEMINI_API_KEY=your_gemini_api_key_from_aistudio
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# 国产大模型（生产环境使用）
# 豆包（字节跳动）
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_MODEL=doubao-lite-4k

# 通义千问（阿里云）
QWEN_API_KEY=your_qwen_api_key
QWEN_MODEL=qwen-turbo

# 智谱AI（ChatGLM）
ZHIPU_API_KEY=your_zhipu_api_key

# 当前使用的AI提供商: gemini | doubao | qwen | zhipu
AI_PROVIDER=gemini

# ============================================
# 数据源API
# ============================================

# 豆瓣API（公开API，有限额）
DOUBAN_API_KEY=

# 其他数据源
TMDB_API_KEY=your_tmdb_api_key

# ============================================
# 服务配置
# ============================================

# 应用配置
APP_NAME=Day One Film AI
APP_VERSION=0.1.0
DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置（生产环境应限制具体域名）
CORS_ORIGINS=["*"]

# ============================================
# 缓存配置（可选）
# ============================================

# Redis配置
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600

# ============================================
# 限流配置
# ============================================

# 每分钟最大请求数
RATE_LIMIT_PER_MINUTE=60

# 搜索限制（防止滥用）
MAX_SEARCH_PER_USER_PER_DAY=100
