# Day One Film AI - 双模型配置
# Gemini 2.0 Flash + Claude 3.5 Sonnet

# ============================================
# API易配置（推荐）
# ============================================

APIYI_BASE_URL=https://api.apiyi.com/v1
APIYI_API_KEY=your_apiyi_key_here

# 模型映射
APIYI_FLASH_MODEL=gemini-2.0-flash
APIYI_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ============================================
# 模型分工策略
# ============================================

# Gemini 2.0 Flash - 主力（80%调用）
# 用途：场景搜索、快速理解、关键词生成
FLASH_MODEL_PROVIDER=apiyi
FLASH_MODEL_NAME=gemini-2.0-flash
FLASH_MODEL_PRICE=0.003  # ¥/1K tokens

# Claude 3.5 Sonnet - 专业（20%调用）
# 用途：剧本拆解、分镜生成、创意描述
CLAUDE_MODEL_PROVIDER=apiyi
CLAUDE_MODEL_NAME=claude-3-5-sonnet-20241022
CLAUDE_MODEL_PRICE=0.015  # ¥/1K tokens

# ============================================
# 任务路由配置
# ============================================

# 简单任务 → Flash
TASK_SIMPLE_MODEL=flash
TASK_SIMPLE_MAX_TOKENS=500

# 复杂任务 → Claude
TASK_COMPLEX_MODEL=claude
TASK_COMPLEX_MAX_TOKENS=2000

# 创意任务 → Claude
TASK_CREATIVE_MODEL=claude

# 快速任务 → Flash
TASK_FAST_MODEL=flash

# ============================================
# B模块：场景搜索（当前开发中）
# ============================================

# 场景理解：Flash（速度快、便宜）
B_SCENE_UNDERSTANDING_MODEL=flash
B_SCENE_UNDERSTANDING_PRICE=0.003

# 关键词生成：Flash
B_KEYWORD_GENERATION_MODEL=flash
B_KEYWORD_GENERATION_PRICE=0.003

# 结果排序：Flash
B_RANKING_MODEL=flash
B_RANKING_PRICE=0.003

# 图片分析：Flash Vision（如果有）
B_IMAGE_ANALYSIS_MODEL=flash
B_IMAGE_ANALYSIS_PRICE=0.007

# ============================================
# A模块：剧本拆解（下一步开发）
# ============================================

# 剧本解析：Claude（长文本理解强）
A_SCRIPT_PARSE_MODEL=claude
A_SCRIPT_PARSE_PRICE=0.015

# 场景提取：Claude（结构化输出好）
A_SCENE_EXTRACTION_MODEL=claude
A_SCENE_EXTRACTION_PRICE=0.015

# 分镜生成：Claude（创意描述强）
A_SHOT_GENERATION_MODEL=claude
A_SHOT_GENERATION_PRICE=0.015

# 角色分析：Claude
A_CHARACTER_ANALYSIS_MODEL=claude
A_CHARACTER_ANALYSIS_PRICE=0.015

# ============================================
# 成本控制
# ============================================

# 自动降级阈值
COST_DAILY_THRESHOLD=50  # ¥50/天
COST_MONTHLY_THRESHOLD=1000  # ¥1000/月

# 当超过阈值，Claude任务降级到Flash
AUTO_DOWNGRADE=true
DOWNGRADE_FROM=claude
DOWNGRADE_TO=flash

# 预算分配
BUDGET_FLASH_PERCENT=80  # 80%预算给Flash
BUDGET_CLAUDE_PERCENT=20  # 20%预算给Claude

# ============================================
# 性能优化
# ============================================

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=3600  # 1小时

# Flash任务超时（快）
FLASH_TIMEOUT=10  # 秒

# Claude任务超时（慢但准）
CLAUDE_TIMEOUT=30  # 秒

# 重试配置
MAX_RETRIES=3
RETRY_DELAY=1  # 秒
